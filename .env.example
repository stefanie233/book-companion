# Book Companion Configuration
# Copy this file to .env and fill in your values

# ── LLM API (OpenAI-compatible) ──
# 推荐：KEY 留空，启动后在网页引导中填写（setup.bat 会自动拉起服务）。
# 高级：也可直接在下面手动填写。
BOOK_COMPANION_API_KEY=
BOOK_COMPANION_API_BASE=https://api.openai.com/v1
BOOK_COMPANION_MODEL=gpt-4o

# ── Optional: Refinement model (defaults to BOOK_COMPANION_MODEL if unset) ──
# REFINEMENT_MODEL=gpt-4o

# ── Optional: Web Search (Tavily — AI-optimized search) ──
# Get a free key at https://tavily.com
# BOOK_COMPANION_SEARCH_API_KEY=tvly-your-key-here

# ── Optional: Embedding / Semantic Search ──
# EMBEDDING_API_KEY=your-embedding-key
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# ── Optional: 默认扫描文件夹（书源卸货区）──
# 留空则不预设，前端扫描按钮会引导输入并本地记忆。
# 填了则在「扫描导入」时直接默认扫描此目录，不用每次输入。
# BOOK_COMPANION_SCAN_FOLDER=D:\path\to\books

# ── Optional: Hermes 飞行记录器 DB（flight-recorder 并排展示 Hermes 会话）──
# 默认自动读取 ~/.hermes/context_log.db（只读）。想换位置或禁用可显式指定。
# BOOK_COMPANION_HERMES_DB=
